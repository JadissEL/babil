generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  comments      Comment[]
  profile       UserProfile?
  favorites     FavoriteCountry[]
  historyEvents UserHistoryEvent[]
  delegatedApplicationRequests DelegatedApplicationRequest[]
}

model UserProfile {
  id               Int     @id @default(autoincrement())
  userId           String  @unique
  income           Float?
  savings          Float?
  CNSS_status      Boolean @default(false)
  marital_status   String?
  family_in_europe Boolean @default(false)
  goal_type        String?
  age              Int?
  family_details   String?
  profession       String?

  /** Primary user objective (slug from `lib/user-objectives/registry.ts`) — drives personalization. */
  primary_objective_slug String?
  /** JSON array of secondary objective slugs (same registry). */
  secondary_objective_slugs Json?
  objective_wizard_completed_at DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Country {
  id                          Int     @id @default(autoincrement())
  name                        String  @unique
  region                      String
  schengen_flag               Boolean @default(false)
  tourist_visa_score          Float? /// 1–10 snapshot; live score from lib/scoring/tourism-mobility in enrich
  study_visa_score            Float? /// 1–10 snapshot; live score from lib/scoring/study-mobility in enrich
  work_visa_score             Float? /// 1–10 snapshot; live score from lib/scoring/work-mobility in enrich
  business_visa_score         Float? /// 1–10 snapshot; prefer recomputing via lib/scoring/business-mobility at read time
  appointment_difficulty      String?
  visa_processing_time        String?
  rejection_risk              String?
  language_study_access       String?
  technical_training_access   String?
  short_course_access         String?
  street_food_business_access String?
  driving_license_status      String?
  full_data                   String? /// JSON fiche : friction_score 0–100, brutal_reality_score 0–10 ; les snapshots visa sont en colonnes 1–10 — voir lib/score-scale-lexicon.ts

  comments           Comment[]
  insights           CountryInsight[]
  favoritedBy        FavoriteCountry[]
  observations       CountryObservation[]
  educationPrograms  CountryEducationProgram[]
  knowledgeProfile   CountryKnowledgeProfile?
}

/** I.10x — Education mobility programmes relationalisés depuis `full_data.education_mobility.*`.
 * Une ligne par couple (countryId, kind). Champs scalaires bucketisés pour filtres indexés (pages 11/12/13).
 */
model CountryEducationProgram {
  id                Int                          @id @default(autoincrement())
  countryId         Int
  kind              EducationProgramKind
  bacBucket         EducationBacBucket           @default(UNKNOWN)
  costBucket        EducationCostBucket          @default(UNKNOWN)
  workRightsBucket  EducationWorkRightsBucket    @default(UNKNOWN)
  programType       String?
  visaType          String?
  durationText      String?
  costText          String?
  estimatedCostText String?
  bacRequiredText   String?
  workRightsText    String?
  access            String?
  insight           String?
  /** Liste des sous-types proposés (typ. short_courses.types, technical_training.types). */
  typesJson         Json?
  /** technical_training: accès post-bac vs sans bac. */
  accessBac         Boolean                      @default(false)
  accessNoBac       Boolean                      @default(false)
  sourceVersion     String?
  updatedAt         DateTime                     @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, kind])
  @@index([kind])
  @@index([kind, bacBucket])
  @@index([kind, costBucket])
}

enum EducationProgramKind {
  LANGUAGE_STUDY
  SHORT_COURSES
  TECHNICAL_TRAINING
}

enum EducationBacBucket {
  NOT_REQUIRED
  REQUIRED
  SCHOOL_DEPENDENT
  UNKNOWN
}

enum EducationCostBucket {
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum EducationWorkRightsBucket {
  ALLOWED
  LIMITED
  FORBIDDEN
  UNKNOWN
}

// --- Country Intelligence System (multi-source, append-only facts) ---

enum IntelligenceSourceTier {
  TIER_A_OFFICIAL
  TIER_B_MULTILATERAL
  TIER_C_CURATED
}

enum ObservationVerificationStatus {
  pending
  verified
  estimated
  disputed
  partially_verified
  needs_review
  contradictory
  outdated
  archived
}

enum SourceDiscoveryStatus {
  pending
  mapping
  complete
  failed
  procedural_no_fetch
}

/** Registre des sources fiables (APIs officielles, organisations internationales, jeux curatés). */
model IntelligenceSource {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique
  name                  String
  tier                  IntelligenceSourceTier
  baseUrl               String?
  licenseNote           String?
  createdAt             DateTime               @default(now())
  /** Phase 1 — gate collecte pour nouvelles sources datafile. */
  discoveryStatus       SourceDiscoveryStatus  @default(pending)
  requiresDiscoveryGate Boolean                @default(false)
  datafileSourceId      String?                @unique
  trustScore            Float?
  authorityScore        Float?
  reliabilityLevel      String?
  updateFrequencyHint   String?
  countryCoverage       String?
  informationTypesJson  String?
  lastVerificationAt    DateTime?
  capabilitiesJson      String?
  observations          CountryObservation[]
  siteInventory         SourceSiteInventory?
  pageIndex             SourcePageIndex[]
}

/** Inventaire structurel d’un site source (sitemap, crawl borné). */
model SourceSiteInventory {
  id             String                @id @default(cuid())
  sourceId       String                @unique
  status         SourceDiscoveryStatus @default(pending)
  sitemapUrl     String?
  robotsPolicy   String?
  capabilitiesJson String?
  pageCount      Int                   @default(0)
  discoveredAt   DateTime              @default(now())
  lastMappedAt   DateTime?
  errorSummary   String?
  source         IntelligenceSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

/** Pages découvertes par source (URL, type, hash pour change_detect). */
model SourcePageIndex {
  id          String             @id @default(cuid())
  sourceId    String
  url         String
  pageType    String             @default("other")
  depth       Int                @default(0)
  parentUrl   String?
  title       String?
  contentHash String?
  lastSeenAt  DateTime           @default(now())
  source      IntelligenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, url])
  @@index([sourceId])
  @@index([sourceId, pageType])
}

/** Taxonomie v2 — définition de champs dynamiques par domaine. */
model FieldDefinition {
  id                  String   @id @default(cuid())
  path                String   @unique
  domain              String
  valueType           String
  unit                String?
  countryOptional     Boolean  @default(false)
  presentationPattern String?
  version             Int      @default(1)
  createdAt           DateTime @default(now())
}

/** Profil de connaissance actif par pays (champs matérialisés / attendus). */
model CountryKnowledgeProfile {
  id                   String   @id @default(cuid())
  countryId            Int      @unique
  activeFieldPathsJson String
  categoryCountJson    String?
  updatedAt            DateTime @updatedAt
  country              Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
}

/** Exécution traçable du pipeline (collecte → validation → persistance). */
model EnrichmentRun {
  id            String   @id @default(cuid())
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  status        String   @default("PENDING")
  trigger       String   @default("manual")
  errorSummary  String?
  statsJson     String?
  observations  CountryObservation[]

  @@index([startedAt])
  @@index([status])
}

/**
 * Fait atomique sur un pays (append-only). `fieldPath` = taxonomie stable (ex. general.population).
 * Résolution multi-sources : voir lib/intelligence-pipeline/merge-observations.ts
 */
model CountryObservation {
  id           String   @id @default(cuid())
  countryId    Int
  fieldPath    String
  valueJson    String
  valueNumeric Float?
  unit         String?
  confidence   Float    @default(0.7)
  observedAt   DateTime @default(now())
  sourceId     String
  runId        String?
  rawPayload   String?
  /** C.43 — clé stable par point de données (ex. World Bank indicateur×pays×année) pour upsert / reprises. */
  dedupeKey    String?  @unique
  verificationStatus ObservationVerificationStatus @default(pending)
  sourcesConfirmed   Int @default(1)
  sourceUrl          String?
  rawExcerpt         String?

  country Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  source  IntelligenceSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  run     EnrichmentRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([countryId, fieldPath])
  @@index([countryId, fieldPath, verificationStatus])
  @@index([sourceId])
  @@index([runId])
  @@index([observedAt])
  @@index([verificationStatus, observedAt])
}

/** C.45 — file d’attente pour exécuter le pipeline hors timeout serverless (worker long-running). */
model IntelligencePipelineJob {
  id           String    @id @default(cuid())
  kind         String
  status       String    @default("PENDING")
  payloadJson  String
  priority     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?
  errorSummary String?
  resultJson   String?

  @@index([status, priority(sort: Desc), createdAt(sort: Asc)])
}

model Comment {
  id        Int           @id @default(autoincrement())
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  userId    String
  countryId Int

  country Country @relation(fields: [countryId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model CountryInsight {
  id                  Int     @id @default(autoincrement())
  countryId           Int
  osint_insights      String?
  real_world_friction String?
  community_sentiment String?

  country Country @relation(fields: [countryId], references: [id])
}

model FavoriteCountry {
  id        Int      @id @default(autoincrement())
  userId    String
  countryId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([userId, countryId])
}

model UserHistoryEvent {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String
  payload   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Demande de délégation candidatures emploi / université — payload JSON canonique versionné */
model DelegatedApplicationRequest {
  id        Int      @id @default(autoincrement())
  userId    String
  category  String
  packageId String
  /** JSON: contact + champs métier dynamiques selon catégorie */
  payload   String
  status    String   @default("SUBMITTED")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/** E.67 — journal append-only des actions admin mutatrices (sans payload brut ni PII). */
model AdminAuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  adminUserId String
  action      String
  resource    String
  detail      String?
  metadata    Json?

  @@index([createdAt(sort: Desc)])
  @@index([adminUserId, createdAt(sort: Desc)])
}

/** Marketplace type Superprof — consultants mobilité (hors objectif tourisme en navigation). */
model ConsultantExpert {
  id              String            @id @default(cuid())
  slug            String            @unique
  displayName     String
  title           String?
  bio             String
  gender          ConsultantGender  @default(UNSPECIFIED)
  specialties     String[]
  price30MinCents Int
  price60MinCents Int
  averageRating   Float             @default(0)
  reviewCount     Int               @default(0)
  notifyEmail     String
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  slots           ConsultantSlot[]
  bookings        ConsultantBooking[]
}

model ConsultantSlot {
  id        String   @id @default(cuid())
  expertId  String
  expert    ConsultantExpert @relation(fields: [expertId], references: [id], onDelete: Cascade)
  startUtc  DateTime
  endUtc    DateTime
  createdAt DateTime @default(now())
  booking   ConsultantBooking?

  @@index([expertId, startUtc])
}

model ConsultantBooking {
  id              String                  @id @default(cuid())
  expertId        String
  expert          ConsultantExpert        @relation(fields: [expertId], references: [id])
  slotId          String                  @unique
  slot            ConsultantSlot          @relation(fields: [slotId], references: [id])
  clerkUserId     String
  customerEmail   String?
  durationMinutes Int
  amountCents     Int
  currency        String                  @default("eur")
  status          ConsultantBookingStatus  @default(PENDING_PAYMENT)
  stripeSessionId String?                 @unique
  stripePaymentId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([clerkUserId])
  @@index([expertId])
}

enum ConsultantGender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum ConsultantBookingStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum Role {
  USER
  ADMIN
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}
