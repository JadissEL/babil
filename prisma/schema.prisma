generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  comments      Comment[]
  profile       UserProfile?
  favorites     FavoriteCountry[]
  historyEvents UserHistoryEvent[]
  delegatedApplicationRequests DelegatedApplicationRequest[]
}

model UserProfile {
  id               Int     @id @default(autoincrement())
  userId           String  @unique
  income           Float?
  savings          Float?
  CNSS_status      Boolean @default(false)
  marital_status   String?
  family_in_europe Boolean @default(false)
  goal_type        String?
  age              Int?
  family_details   String?
  profession       String?

  /** Primary user objective (slug from `lib/user-objectives/registry.ts`) — drives personalization. */
  primary_objective_slug String?
  /** JSON array of secondary objective slugs (same registry). */
  secondary_objective_slugs Json?
  objective_wizard_completed_at DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Country {
  id                          Int     @id @default(autoincrement())
  name                        String  @unique
  region                      String
  schengen_flag               Boolean @default(false)
  tourist_visa_score          Float? /// 1–10 snapshot; live score from lib/scoring/tourism-mobility in enrich
  study_visa_score            Float? /// 1–10 snapshot; live score from lib/scoring/study-mobility in enrich
  work_visa_score             Float? /// 1–10 snapshot; live score from lib/scoring/work-mobility in enrich
  business_visa_score         Float? /// 1–10 snapshot; prefer recomputing via lib/scoring/business-mobility at read time
  appointment_difficulty      String?
  visa_processing_time        String?
  rejection_risk              String?
  language_study_access       String?
  technical_training_access   String?
  short_course_access         String?
  street_food_business_access String?
  driving_license_status      String?
  full_data                   String? /// JSON fiche : friction_score 0–100, brutal_reality_score 0–10 ; les snapshots visa sont en colonnes 1–10 — voir lib/score-scale-lexicon.ts

  comments      Comment[]
  insights      CountryInsight[]
  favoritedBy   FavoriteCountry[]
  observations  CountryObservation[]
}

// --- Country Intelligence System (multi-source, append-only facts) ---

enum IntelligenceSourceTier {
  TIER_A_OFFICIAL
  TIER_B_MULTILATERAL
  TIER_C_CURATED
}

/** Registre des sources fiables (APIs officielles, organisations internationales, jeux curatés). */
model IntelligenceSource {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  name         String
  tier         IntelligenceSourceTier
  baseUrl      String?
  licenseNote  String?
  createdAt    DateTime               @default(now())
  observations CountryObservation[]
}

/** Exécution traçable du pipeline (collecte → validation → persistance). */
model EnrichmentRun {
  id            String   @id @default(cuid())
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  status        String   @default("PENDING")
  trigger       String   @default("manual")
  errorSummary  String?
  statsJson     String?
  observations  CountryObservation[]

  @@index([startedAt])
  @@index([status])
}

/**
 * Fait atomique sur un pays (append-only). `fieldPath` = taxonomie stable (ex. general.population).
 * Résolution multi-sources : voir lib/intelligence-pipeline/merge-observations.ts
 */
model CountryObservation {
  id           String   @id @default(cuid())
  countryId    Int
  fieldPath    String
  valueJson    String
  valueNumeric Float?
  unit         String?
  confidence   Float    @default(0.7)
  observedAt   DateTime @default(now())
  sourceId     String
  runId        String?
  rawPayload   String?
  /** C.43 — clé stable par point de données (ex. World Bank indicateur×pays×année) pour upsert / reprises. */
  dedupeKey    String?  @unique

  country Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  source  IntelligenceSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  run     EnrichmentRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([countryId, fieldPath])
  @@index([sourceId])
  @@index([runId])
  @@index([observedAt])
}

/** C.45 — file d’attente pour exécuter le pipeline hors timeout serverless (worker long-running). */
model IntelligencePipelineJob {
  id           String    @id @default(cuid())
  kind         String
  status       String    @default("PENDING")
  payloadJson  String
  priority     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?
  errorSummary String?
  resultJson   String?

  @@index([status, priority(sort: Desc), createdAt(sort: Asc)])
}

model Comment {
  id        Int           @id @default(autoincrement())
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  userId    String
  countryId Int

  country Country @relation(fields: [countryId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model CountryInsight {
  id                  Int     @id @default(autoincrement())
  countryId           Int
  osint_insights      String?
  real_world_friction String?
  community_sentiment String?

  country Country @relation(fields: [countryId], references: [id])
}

model FavoriteCountry {
  id        Int      @id @default(autoincrement())
  userId    String
  countryId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([userId, countryId])
}

model UserHistoryEvent {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String
  payload   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Demande de délégation candidatures emploi / université — payload JSON canonique versionné */
model DelegatedApplicationRequest {
  id        Int      @id @default(autoincrement())
  userId    String
  category  String
  packageId String
  /** JSON: contact + champs métier dynamiques selon catégorie */
  payload   String
  status    String   @default("SUBMITTED")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/** E.67 — journal append-only des actions admin mutatrices (sans payload brut ni PII). */
model AdminAuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  adminUserId String
  action      String
  resource    String
  detail      String?
  metadata    Json?

  @@index([createdAt(sort: Desc)])
  @@index([adminUserId, createdAt(sort: Desc)])
}

enum Role {
  USER
  ADMIN
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}
