# Copy to .env and fill values. Never commit .env.

# Prisma (managed PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Optional manual sync flow:
# - LOCAL_DATABASE_URL is the database used by your local runner for incremental enrichment
# - RENDER_DATABASE_URL is the target Render PostgreSQL database to update manually
# LOCAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/LOCAL_DATABASE"
# RENDER_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/RENDER_DATABASE"

# Clerk (https://dashboard.clerk.com → your app → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk URLs (defaults work if you use Clerk-hosted pages)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/overview
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/overview

# Optional autonomous agent tuning
# AGENT_TICK_MS=30000
# AGENT_REFRESH_MS=21600000
# AGENT_WORKER_BATCH=8
# AGENT_TASK_TTL_HOURS=72
# AGENT_RETRY_BASE_DELAY_MS=600000
# AGENT_RETRY_MAX_DELAY_MS=21600000
# AGENT_VERBOSE=1
# 0 = minimal, 1 = task flow, 2 = detailed timings/extra internals
