# Copy to .env and fill values. Never commit .env.

# Prisma (managed PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Optional manual sync flow (npm run sync:render:apply):
# - LOCAL_DATABASE_URL: DB the runner wrote to (defaults to DATABASE_URL if unset)
# - RENDER_DATABASE_URL: target Render PostgreSQL
# LOCAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/LOCAL_DATABASE"
# RENDER_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/RENDER_DATABASE"

# Clerk (https://dashboard.clerk.com → your app → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk URLs (defaults work if you use Clerk-hosted pages)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/overview
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/overview

# Optional autonomous agent tuning
# AGENT_TICK_MS=30000
# AGENT_REFRESH_MS=21600000
# AGENT_WORKER_BATCH=1
# AGENT_TASK_TTL_HOURS=72
# AGENT_RETRY_BASE_DELAY_MS=600000
# AGENT_RETRY_MAX_DELAY_MS=21600000
# AGENT_MAX_RECURSION_PASSES=4
# AGENT_COMPLETENESS_TARGET=85
# AGENT_STABLE_SCORE_MIN_ATTEMPTS=3
# AGENT_STABLE_SCORE_DELTA=0
# AGENT_REENRICH_INTERVAL_HOURS=24
# AGENT_VERBOSE=1
# 0 = minimal, 1 = task flow, 2 = detailed timings/extra internals

# Intelligence pipeline (C.52) — désactiver la collecte par slug (virgules, insensible à la casse)
# INTELLIGENCE_SOURCE_DISABLED_SLUGS=world_bank_open_data,oecd

# Moteurs POST (D.59–D.60) — limite taille corps JSON (octets) et rate limit / minute
# BABIL_ENGINE_POST_MAX_CONTENT_LENGTH=65536
# BABIL_ENGINE_RATE_LIMIT_AUTH_PER_MINUTE=60
# BABIL_ENGINE_RATE_LIMIT_ANON_PER_MINUTE=30
# BABIL_ENGINE_RATE_LIMIT_DISABLED=0

# Commentaires (E.72) — anti-spam sur POST /api/comments (fenêtre 1 min, mémoire par instance)
# BABIL_COMMENT_POST_RATE_LIMIT_PER_MINUTE=12
# BABIL_COMMENT_POST_RATE_LIMIT_PER_IP_PER_MINUTE=40
# BABIL_COMMENT_POST_RATE_LIMIT_DISABLED=0

# Pipeline intelligence (D.61) — timeout HTTP sortant World Bank (ms, défaut 45000, max 120000)
# INTELLIGENCE_HTTP_TIMEOUT_MS=45000
