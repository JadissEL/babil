# Copy to .env and fill values. Never commit .env.

# Prisma (managed PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Optional manual sync flow (npm run sync:render:apply):
# - LOCAL_DATABASE_URL: DB the runner wrote to (defaults to DATABASE_URL if unset)
# - RENDER_DATABASE_URL: target Render PostgreSQL
# LOCAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/LOCAL_DATABASE"
# RENDER_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/RENDER_DATABASE"

# Clerk (https://dashboard.clerk.com → your app → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk URLs (defaults work if you use Clerk-hosted pages)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/overview
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/overview

# Optional autonomous agent tuning
# AGENT_TICK_MS=30000
# AGENT_REFRESH_MS=21600000
# AGENT_WORKER_BATCH=1
# AGENT_TASK_TTL_HOURS=72
# AGENT_RETRY_BASE_DELAY_MS=600000
# AGENT_RETRY_MAX_DELAY_MS=21600000
# AGENT_MAX_RECURSION_PASSES=4
# AGENT_COMPLETENESS_TARGET=85
# AGENT_STABLE_SCORE_MIN_ATTEMPTS=3
# AGENT_STABLE_SCORE_DELTA=0
# AGENT_REENRICH_INTERVAL_HOURS=24
# AGENT_VERBOSE=1
# 0 = minimal, 1 = task flow, 2 = detailed timings/extra internals

# Intelligence pipeline (C.52) — désactiver la collecte par slug (virgules, insensible à la casse)
# INTELLIGENCE_SOURCE_DISABLED_SLUGS=world_bank_open_data,oecd

# Moteurs POST (D.59–D.60) — limite taille corps JSON (octets) et rate limit / minute
# BABIL_ENGINE_POST_MAX_CONTENT_LENGTH=65536
# BABIL_ENGINE_RATE_LIMIT_AUTH_PER_MINUTE=60
# BABIL_ENGINE_RATE_LIMIT_ANON_PER_MINUTE=30
# BABIL_ENGINE_RATE_LIMIT_DISABLED=0

# Commentaires (E.72) — anti-spam sur POST /api/comments (fenêtre 1 min, mémoire par instance)
# BABIL_COMMENT_POST_RATE_LIMIT_PER_MINUTE=12
# BABIL_COMMENT_POST_RATE_LIMIT_PER_IP_PER_MINUTE=40
# BABIL_COMMENT_POST_RATE_LIMIT_DISABLED=0

# Origines autorisées pour mutations API en production (E.68) — voir docs/catalogue-e-security.md
# NEXT_PUBLIC_APP_URL=https://votre-domaine.com
# BABIL_APP_URL=https://votre-domaine.com
# BABIL_ALLOWED_ORIGINS=https://www.votre-domaine.com,https://votre-domaine.com
# (Vercel fournit VERCEL_URL ; Render : RENDER_EXTERNAL_URL — compléter si domaine custom différent)
# BABIL_MUTATION_ORIGIN_GUARD_DISABLED=0

# Webhook signé (E.76) — secret partagé avec l’émetteur ; signature HMAC-SHA256 du corps brut
# Corps JSON optionnel : event "ping" | "webhook.ping" | "intelligence.pipeline.run" (+ mode "full"|"materialize")
# BABIL_WEBHOOK_INGEST_SECRET=

# Pipeline intelligence (D.61) — timeout HTTP sortant World Bank (ms, défaut 45000, max 120000)
# INTELLIGENCE_HTTP_TIMEOUT_MS=45000
# G.93 — alerte log (msg pipeline_external_calls_budget_soft_exceeded) si apiBatchCalls WB > seuil pour un run. Optionnel.
# INTELLIGENCE_PIPELINE_WB_HTTP_SOFT_LIMIT=

# G.91 — log d’accès JSON sur `/api/*` (middleware Edge). Désactiver: BABIL_API_ACCESS_LOG=0 ; forcer en local: BABIL_API_ACCESS_LOG=1
# BABIL_API_ACCESS_LOG=
# G.92 — latence handler (ms) sur pays / reco / proba. Désactiver: BABIL_API_ROUTE_LATENCY_LOG=0 ; forcer en local: BABIL_API_ROUTE_LATENCY_LOG=1
# BABIL_API_ROUTE_LATENCY_LOG=

# --- Observabilité (G.90) — Sentry (optionnel ; sans DSN, le SDK ne s’initialise pas)
# Projet Next.js : une seule URL DSN côté client + serveur suffit en général.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Taux d’échantillonnage des traces performance (0–1). Défaut 0.1 côté navigateur, 0.1 serveur.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Upload des source maps en CI / build local (optionnel) :
# SENTRY_ORG=votre-org
# SENTRY_PROJECT=babil
# SENTRY_AUTH_TOKEN=
