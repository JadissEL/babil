    "@sentry/nextjs": "^10.52.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "flag-icons": "^7.5.0",
    "lucide-react": "^0.378.0",
    "next": "^14.2.35",
    "prisma": "^6.19.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.3.0",
    "zod": "^4.4.3"
  },
