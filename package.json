{
  "name": "babil",
  "version": "1.0.0",
  "main": "index.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "validate:hero": "tsx scripts/validate-hero-slides.ts",
    "dev": "next dev",
    "build": "npm run validate:hero && npm run validate:schengen-keys && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate-deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:setup": "npm run db:push && npm run seed",
    "start:render": "npm run db:migrate-deploy && npm run seed && next start",
    "seed": "tsx prisma/seed.ts",
    "lint": "next lint",
    "format": "prettier --write \"app/api/**/*.{ts,tsx}\" \"app/error.tsx\" \"app/(dashboard)/error.tsx\" \"app/global-error.tsx\" \"app/(public)/countries/[id]/layout.tsx\" \"app/(public)/recommendations/page.tsx\" \"app/(public)/probability/page.tsx\" \"app/(public)/services/delegated-applications/page.tsx\" \"app/(public)/services/delegated-applications/apply/DelegatedApplicationApplyClient.tsx\" \"components/monetization/DeepReportTeaser.tsx\" \"components/recommendation/RecommendationEnginePage.tsx\" \"components/services/DelegatedServiceCatalog.tsx\" \"agents/**/*.ts\" \"lib/types/**/*.ts\" \"lib/api-schemas/**/*.ts\" \"lib/agent-full-data-persist-guard.ts\" \"lib/agent-http-retry.ts\" \"lib/api-route-latency.ts\" \"lib/pipeline-external-budget.ts\" \"lib/request-id-constants.ts\" \"lib/request-id.ts\" \"lib/structured-log.ts\" \"lib/country-layout-meta.ts\" \"lib/country-page-json-ld.ts\" \"lib/site-public-url.ts\" \"lib/reco-proba-focus-country.ts\" \"lib/api-routes-critical.vitest.ts\" \"lib/agent-full-data-persist-guard.vitest.ts\" \"lib/agent-http-retry.vitest.ts\" \"lib/api-route-latency.vitest.ts\" \"lib/pipeline-external-budget.vitest.ts\" \"lib/health-route.vitest.ts\" \"lib/request-id.vitest.ts\" \"lib/country-page-json-ld.vitest.ts\" \"lib/site-public-url.vitest.ts\" \"lib/reco-proba-focus-country.vitest.ts\" \"vitest.config.ts\"",
    "format:check": "prettier --check \"app/api/**/*.{ts,tsx}\" \"app/error.tsx\" \"app/(dashboard)/error.tsx\" \"app/global-error.tsx\" \"app/(public)/countries/[id]/layout.tsx\" \"app/(public)/recommendations/page.tsx\" \"app/(public)/probability/page.tsx\" \"app/(public)/services/delegated-applications/page.tsx\" \"app/(public)/services/delegated-applications/apply/DelegatedApplicationApplyClient.tsx\" \"components/monetization/DeepReportTeaser.tsx\" \"components/recommendation/RecommendationEnginePage.tsx\" \"components/services/DelegatedServiceCatalog.tsx\" \"agents/**/*.ts\" \"lib/types/**/*.ts\" \"lib/api-schemas/**/*.ts\" \"lib/agent-full-data-persist-guard.ts\" \"lib/agent-http-retry.ts\" \"lib/api-route-latency.ts\" \"lib/pipeline-external-budget.ts\" \"lib/request-id-constants.ts\" \"lib/request-id.ts\" \"lib/structured-log.ts\" \"lib/country-layout-meta.ts\" \"lib/country-page-json-ld.ts\" \"lib/site-public-url.ts\" \"lib/reco-proba-focus-country.ts\" \"lib/api-routes-critical.vitest.ts\" \"lib/agent-full-data-persist-guard.vitest.ts\" \"lib/agent-http-retry.vitest.ts\" \"lib/api-route-latency.vitest.ts\" \"lib/pipeline-external-budget.vitest.ts\" \"lib/health-route.vitest.ts\" \"lib/request-id.vitest.ts\" \"lib/country-page-json-ld.vitest.ts\" \"lib/site-public-url.vitest.ts\" \"lib/reco-proba-focus-country.vitest.ts\" \"vitest.config.ts\"",
    "check": "npm run test:lib && npm run test:vitest && npm run validate:schengen-keys && npm run format:check && npm run lint",
    "agents:start": "tsx agents/runner.ts",
    "agent:extract-patterns": "tsx scripts/agent-extract-patterns.ts",
    "agent:manifest-scaffold": "tsx scripts/scaffold-agent-manifest-url-map.ts",
    "quotes:build": "tsx scripts/build-traveler-quotes.ts",
    "quotes:import": "tsx scripts/import-traveler-quotes.ts",
    "export:schengen-keys": "tsx scripts/export-schengen-lookup-keys.ts",
    "validate:schengen-keys": "tsx scripts/validate-schengen-lookup-keys.ts",
    "sync:render:dry": "tsx scripts/sync-countries-to-render.ts",
    "sync:render:apply": "tsx scripts/sync-countries-to-render.ts --apply",
    "db:backfill:dry": "tsx scripts/backfill-country-structured-data.ts --dry-run",
    "db:backfill:apply": "tsx scripts/backfill-country-structured-data.ts --apply",
    "db:backfill:hydrate:dry": "tsx scripts/backfill-country-structured-data.ts --dry-run --hydrate-static",
    "db:backfill:hydrate:apply": "tsx scripts/backfill-country-structured-data.ts --apply --hydrate-static",
    "db:backfill:coverage:dry": "tsx scripts/backfill-country-structured-data.ts --dry-run --with-contract-coverage",
    "db:backfill:coverage:apply": "tsx scripts/backfill-country-structured-data.ts --apply --with-contract-coverage",
    "db:report-contract": "tsx scripts/report-db-contract-summary.ts",
    "db:upsert-missing:dry": "tsx scripts/upsert-missing-countries-from-static.ts --dry-run",
    "db:upsert-missing:apply": "tsx scripts/upsert-missing-countries-from-static.ts --apply",
    "intelligence:seed-sources": "tsx scripts/intelligence-enrichment-pipeline.ts --seed-sources-only",
    "intelligence:pipeline": "tsx scripts/intelligence-enrichment-pipeline.ts",
    "intelligence:world-bank": "tsx scripts/intelligence-enrichment-pipeline.ts --world-bank",
    "intelligence:materialize-economy": "tsx scripts/intelligence-enrichment-pipeline.ts --materialize",
    "intelligence:world-bank:materialize": "tsx scripts/intelligence-enrichment-pipeline.ts --world-bank --materialize",
    "intelligence:check-run-alerts": "tsx scripts/check-enrichment-run-alerts.ts",
    "intelligence:enqueue-job": "tsx scripts/intelligence-pipeline-enqueue.ts",
    "intelligence:worker-once": "tsx scripts/intelligence-pipeline-worker-once.ts",
    "db:prune-observations:dry": "tsx scripts/prune-country-observations.ts --dry-run --older-than-days=730",
    "db:prune-observations": "tsx scripts/prune-country-observations.ts --older-than-days=730",
    "db:compact-observations:dry": "tsx scripts/compact-country-observations.ts --dry-run",
    "db:compact-observations": "tsx scripts/compact-country-observations.ts",
    "test:lib": "tsx --test \"lib/**/*.test.ts\"",
    "test:vitest": "vitest run",
    "audit:ci": "npm audit --omit=dev --audit-level=critical"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@clerk/nextjs": "^6.39.3",
